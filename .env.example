# Neo4j (docker-compose.yml)
NEO4J_VERSION=5.26
NEO4J_CONTAINER_NAME=eggseller-neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-segura
# URI para desarrollo local (npm run dev fuera de Docker)
NEO4J_URI=bolt://localhost:7687
# URI que usa la web DENTRO de la red Docker (nombre del servicio, no localhost)
NEO4J_URI_INTERNAL=bolt://neo4j:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Web Next.js en contenedor (docker-compose.yml)
WEB_IMAGE=eggseller-web:latest
WEB_CONTAINER_NAME=eggseller-web
WEB_PORT=3000
# Red Docker compartida para que la web alcance a Neo4j
DOCKER_NETWORK=eggseller-net

# OpenCode (integración IA en la web, solo server-side)
# Clave temporal solo para desarrollo local, será revocada
OPENCODE_API_KEY=tu-clave-temporal-aqui
# Modelo a usar siempre: Big Pickle (gratuito de OpenCode)
OPENCODE_MODEL=opencode/big-pickle
# Puerto del servidor OpenCode embebido y timeout de arranque (ms)
OPENCODE_PORT=4096
OPENCODE_TIMEOUT_MS=30000
# URL pública de la app (para que OpenCode alcance el MCP embebido)
APP_URL=http://127.0.0.1:3000
